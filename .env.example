PORT=3000
PARSER_URL=http://localhost:3001
ENRICHMENT_URL=http://localhost:3002
TARIFF_URL=http://localhost:3003
PURCHASING_URL=http://localhost:3004

# Copy to .env and fill in real values.
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here
# Required for Digi-Key Ordering API (credit account). Quotes work without this.
# DIGIKEY_ACCOUNT_ID=
# DIGIKEY_ORDERING_ENABLED=false

# MOUSER_API_KEY=
# MOUSER_ORDERING_ENABLED=false

AWS_REGION=us-west-2

# DynamoDB tables provisioned by prokuroInfrastructureCDK (PartsStorage + Billing).
PARTS_TABLE=prokuro-parts
UNRESOLVED_TABLE=prokuro-unresolved
BILLING_TABLE=prokuro-billing

# Digi-Key Product Information quotas (required — no defaults).
# billing@prokuro.ai contract: 480/min, 50_000/day.
DIGIKEY_MAX_PER_MINUTE=480
DIGIKEY_MAX_PER_DAY=50000
DIGIKEY_MAX_CONCURRENCY=8

# Background unresolved-queue drain (required).
UNRESOLVED_DRAIN_BATCH=32

# OTel metrics: leave disabled for local/test (no CloudWatch export cost)
OTEL_SDK_DISABLED=true

# Stripe (SaaS plans per Cognito account). Leave empty to disable billing service.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
# BILLING_REQUIRED=false

# Onboarding pilots without Stripe checkout (internal only).
# PROKURO_ADMIN_SECRET=change-me
# POST /v1/billing/admin/plan with header X-Prokuro-Admin-Secret

# Team invites (SES direct, or SNS topic → Lambda → SES in AWS).
# MEMBERS_TABLE=prokuro-members
# APP_BASE_URL=http://localhost:3010
# TEAM_INVITE_FROM_EMAIL=noreply@prokuro.ai
# TEAM_INVITE_SNS_TOPIC_ARN=arn:aws:sns:...

# Optional: override daily Digi-Key refresh interval (default 86400).
# ENRICHMENT_DAILY_SYNC_SECS=86400
